# Postgres connection string. The Neon integration on Vercel sets this for you.
DATABASE_URL=
# The password you type to open the app.
APP_PASSWORD=
# Leave unset. "1" turns the deployment into a public demo with no password and no saving.
# DEMO_MODE=

# --- Live demo AI guide (live demo only; never set on a personal install) ----
# A chat panel on the /app screens that answers visitors from the sample trip,
# opens screens as it explains and qualifies leads (lib/demo-agent). It runs
# only when DEMO_MODE=1 AND this is "1".
# NEXT_PUBLIC_DEMO_AGENT=1
# Model calls go through Vercel AI Gateway. On Vercel, OIDC authenticates
# automatically; locally, set a gateway key. Set a spend limit on the gateway.
# AI_GATEWAY_API_KEY=
# Optional model override (default anthropic/claude-haiku-5.5).
# DEMO_AGENT_MODEL=
# "New lead" emails when a visitor leaves their email in the guide (email and
# structured answers, never the chat), sent through the Resend REST API.
# All three are needed; unset = no lead emails (the signup still works).
# DEMO_AGENT_LEAD_TO=you@example.com
# DEMO_AGENT_FROM_EMAIL="Nomad Expenses <guide@example.com>"
# RESEND_API_KEY=
